# ─── Database ───────────────────────────────────────────────
# Local default: SQLite (no Docker required)
DATABASE_URL=file:./dev.db
# Production / Docker Postgres:
# DATABASE_URL=postgresql://rugkiller:rugkiller@localhost:5432/rugkiller?schema=public

REDIS_URL=redis://localhost:6379
# When true (default for local), API/worker start without Redis
REDIS_OPTIONAL=true

# ─── Arc Testnet (analysis) ─────────────────────────────────
ARC_RPC_URL=https://rpc.drpc.testnet.arc.network
ARC_WS_URL=wss://rpc.testnet.arc.network
ARC_CHAIN_ID=5042002
ARC_EXPLORER_API=https://testnet.arcscan.app/api
ARC_EXPLORER_V2=https://testnet.arcscan.app/api/v2
ARC_EXPLORER_URL=https://testnet.arcscan.app

# ─── Robinhood Chain (cross-chain intel) ────────────────────
ROBINHOOD_RPC_URL=
ROBINHOOD_CHAIN_ID=4663
ROBINHOOD_EXPLORER_API=https://robinhoodchain.blockscout.com/api
ROBINHOOD_EXPLORER_V2=https://robinhoodchain.blockscout.com/api/v2
ROBINHOOD_EXPLORER_URL=https://robinhoodchain.blockscout.com

# ─── x402 payments (Base; independent of analysis) ──────────
# Set your USDC receive wallet before enabling paid prod traffic

FREE_ANALYSES_PER_DAY=10
FREE_API_REQUESTS_PER_MINUTE=30

# ─── App ────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=4000
WEB_PORT=3000
API_PUBLIC_URL=http://localhost:4000
BRIDGE_INDEXER_API_URL=http://localhost:4000
BRIDGE_INDEXER_POLL_MS=60000
OBSERVED_MAINNET_INDEXER_POLL_MS=300000
BRIDGE_SETTLEMENT_POLL_MS=60000
SOLANA_CCTP_POLL_MS=120000
EVM_CCTP_BACKFILL_POLL_MS=60000
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
WEB_PUBLIC_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
# Comma-separated admin wallet addresses (empty = open admin in development only)
ADMIN_WALLETS=
JWT_SECRET=change-me-to-a-long-random-string
SESSION_TTL_HOURS=168

ARC_INDEXER_POLL_MS=60000
ROBINHOOD_INDEXER_POLL_MS=120000
ANALYSIS_CONCURRENCY=2
RISK_MODEL_VERSION=1.0.0

# Observed, unannounced Arc network (chain id 5042).
# The chain answers over RPC, so contract facts stay readable.
OBSERVED_ARC_CHAIN_ID=5042
OBSERVED_ARC_RPC_URL=https://5042.rpc.thirdweb.com
# The keyless thirdweb endpoint can be refused from datacenter IPs. Add a
# keyed or alternative endpoint here (comma separated) if the API reports
# rpcError on /observed-mainnet/tokens/:address. A thirdweb client id goes on
# the path: https://5042.rpc.thirdweb.com/<clientId>
OBSERVED_ARC_RPC_FALLBACK_URLS=
# Blockscout base URL, no trailing slash and no /api/v2. There is no public
# explorer for this chain right now; leave empty. Without it, holder lists,
# creator addresses, source verification and token discovery are reported as
# gaps rather than guessed.
OBSERVED_ARC_EXPLORER_URL=
# Holder distribution and creator addresses on 5042 are rebuilt from Transfer
# logs over RPC, because there is no explorer to ask.
OBSERVED_ARC_HOLDER_POLL_MS=120000
OBSERVED_ARC_HOLDER_BATCH=3
